# Copy to frontend/.env (or .env.local). Vite only reads env files from this frontend/ directory,
# not from the repo root, and inlines VITE_* values into the bundle at build time.

# Backend base URL (no trailing slash). Default when unset: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# LOCAL DEV ONLY - optional fallback API key baked into the JS bundle. Anyone who loads the
# built app can read it, so never set it for a deployment. Prefer pasting the key into the
# "Operator API key" field in the top bar and pressing Connect (stored in localStorage).
# VITE_RECEIVING_API_KEY=change-me-operator-key
