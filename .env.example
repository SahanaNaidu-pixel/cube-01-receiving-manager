# Copy to .env (repo root). The backend loads it automatically; real environment variables win.

# --- Perception ---------------------------------------------------------------
# DEMO_MODE=true additionally allows scripted demo scenarios (?scenario=..., used by the Benchmark page).
# A run without a scenario ALWAYS reads the real photos with the AI model below; with no key it is held
# for review (PENDING_REVIEW), never given a scripted verdict. Set DEMO_MODE=false in production.
DEMO_MODE=true
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_TIMEOUT_S=45
# One focused follow-up model call, only when a check is left disputed or low-visibility. false = single pass.
AI_SECOND_LOOK=true
# auto = OpenAI Responses API on api.openai.com, Chat Completions when OPENAI_BASE_URL is set (vLLM, Ollama,
# LiteLLM, OpenRouter, Azure...). Force with responses or chat.
AI_API_STYLE=auto
# Stream the model's output so the UI shows, live, which photo the model is reading. false = one blocking call.
AI_STREAM=true
# high reads small label print (more image tokens); low / auto is cheaper and faster.
AI_IMAGE_DETAIL=high

# --- Auth & evidence ------------------------------------------------------------
# key -> tenant/operator/role. Roles: operator, approver (only approvers may override to PASS).
# The "change-me" keys below are public and are refused unless DEMO_MODE=true. Generate real keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
RECEIVING_API_KEYS={"change-me-operator-key":{"organization_id":"org-demo","operator_id":"op-1","role":"operator"},"change-me-approver-key":{"organization_id":"org-demo","operator_id":"sup-1","role":"approver"}}
# HMAC key for sealing evidence records (generate like the API keys). Empty = a per-process key, so
# records sealed before a restart no longer verify. Keep it outside the database; rotate with care.
RECEIVING_SEAL_KEY=

# --- Storage & limits -------------------------------------------------------------
DATABASE_URL=sqlite:///./receiving_manager.db
UPLOAD_ROOT_DIR=uploads
MAX_IMAGE_SIZE_MB=10
UPLOAD_MAX_IMAGES=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# --- Server -----------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend settings live in frontend/.env (see frontend/.env.example): Vite does not read this file.
