# Copy to .env (repo root). The backend loads it automatically; real environment variables win.

# --- Perception ---------------------------------------------------------------
# DEMO_MODE=true simulates perception from a chosen scenario (?scenario=...), so the caller picks the
# outcome. Local demos only: set DEMO_MODE=false (and an AI key) for anything real.
DEMO_MODE=true
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_TIMEOUT_S=45
# auto | openai | demo | none. auto = demo if DEMO_MODE=true, else openai if a key is set, else none.
# none (or no key) = every run is held as PENDING_REVIEW unless the operator records manual observations.
VISION_PROVIDER=auto
# fail | review. review: visible damage / reported carton damage gives UNCERTAIN (human review) instead of FAIL.
DAMAGE_POLICY=fail

# --- Auth & evidence ------------------------------------------------------------
# key -> tenant/operator/role. Roles: operator, approver (only approvers may override to PASS).
# The "change-me" keys below are public and are refused unless DEMO_MODE=true. Generate real keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
RECEIVING_API_KEYS={"change-me-operator-key":{"organization_id":"org-demo","operator_id":"op-1","role":"operator"},"change-me-approver-key":{"organization_id":"org-demo","operator_id":"sup-1","role":"approver"}}
# HMAC key for sealing evidence records (generate like the API keys). Empty = a per-process key, so
# records sealed before a restart no longer verify. Keep it outside the database; rotate with care.
RECEIVING_SEAL_KEY=

# --- Storage & limits -------------------------------------------------------------
DATABASE_URL=sqlite:///./receiving_manager.db
UPLOAD_ROOT_DIR=uploads
MAX_IMAGE_SIZE_MB=10
UPLOAD_MAX_IMAGES=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# --- A2A (cube.a2a.v1) -----------------------------------------------------------
AGENT_ID=receiving_manager
APP_VERSION=1.0.0
# Outbound hand-off targets. Empty = hand-offs are recorded as not_configured (never reported as delivered).
# {"prep_manager":"https://prep.example/api/agent/receive"} or {"prep_manager":{"url":"https://...","api_key":"..."}}
A2A_PEERS=
# Give other agents their own key with "role":"agent" in RECEIVING_API_KEYS (treated like an operator).

# --- Server -----------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend settings live in frontend/.env (see frontend/.env.example): Vite does not read this file.
