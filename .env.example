AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
DEMO_MODE=true
DATABASE_URL=sqlite:///./receiving_manager.db
MAX_IMAGE_SIZE_MB=10
UPLOAD_MAX_IMAGES=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
UPLOAD_ROOT_DIR=uploads
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
OPENAI_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com
VITE_API_BASE_URL=http://localhost:8000
AI_TIMEOUT_S=45
# key -> tenant/operator/role. Roles: operator, approver (only approvers may override to PASS)
RECEIVING_API_KEYS={"change-me-operator-key":{"organization_id":"org-demo","operator_id":"op-1","role":"operator"},"change-me-approver-key":{"organization_id":"org-demo","operator_id":"sup-1","role":"approver"}}
# HMAC key for sealing evidence records. Keep it outside the database; rotate with care (old seals stop verifying).
RECEIVING_SEAL_KEY=
# Local dev only: baked into the JS bundle. Prefer localStorage.setItem('receivingApiKey', '<key>').
VITE_RECEIVING_API_KEY=
