# Copy to .env (repo root). The backend loads it automatically; real environment variables win.

# --- Perception ---------------------------------------------------------------
# DEMO_MODE=true simulates perception from a chosen scenario (?scenario=...), so the caller picks the
# outcome. Local demos only: set DEMO_MODE=false (and an AI key) for anything real.
DEMO_MODE=true
# AI_PROVIDER: openai (default), gemini, or ollama.
#   gemini: free tier, key from https://aistudio.google.com/apikey
#   ollama: runs on this computer, no key, nothing leaves the machine (install https://ollama.com, then
#           `ollama pull qwen2.5vl:3b`). Slow without a strong GPU: allow 1-3 minutes per inspection.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_S=300
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_TIMEOUT_S=45

# --- Auth & evidence ------------------------------------------------------------
# key -> tenant/operator/role. Roles: operator, approver (only approvers may override to PASS).
# The "change-me" keys below are public and are refused unless DEMO_MODE=true. Generate real keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
RECEIVING_API_KEYS={"change-me-operator-key":{"organization_id":"org-demo","operator_id":"op-1","role":"operator"},"change-me-approver-key":{"organization_id":"org-demo","operator_id":"sup-1","role":"approver"}}
# HMAC key for sealing evidence records (generate like the API keys). Empty = a per-process key, so
# records sealed before a restart no longer verify. Keep it outside the database; rotate with care.
RECEIVING_SEAL_KEY=

# --- Storage & limits -------------------------------------------------------------
DATABASE_URL=sqlite:///./receiving_manager.db
UPLOAD_ROOT_DIR=uploads
MAX_IMAGE_SIZE_MB=10
UPLOAD_MAX_IMAGES=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# --- Server -----------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend settings live in frontend/.env (see frontend/.env.example): Vite does not read this file.
