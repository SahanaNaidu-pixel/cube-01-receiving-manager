{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_card.v1.schema.json",
  "title": "CUBE agent card (cube.a2a.v1)",
  "description": "Served at GET /.well-known/agent.json (public) and GET /api/agent/capabilities.",
  "type": "object",
  "required": ["a2a_version", "agent_id", "name", "version", "description", "endpoint", "auth", "record_schema", "operations", "status"],
  "additionalProperties": true,
  "properties": {
    "a2a_version": {"const": "cube.a2a.v1"},
    "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9._:\\-]{1,128}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "endpoint": {"type": "string", "minLength": 1},
    "auth": {
      "type": "object",
      "required": ["type", "header"],
      "properties": {"type": {"const": "api_key"}, "header": {"type": "string"}}
    },
    "record_schema": {"const": "receiving_record.v1"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "description", "input_schema", "output_schema"],
        "properties": {
          "operation": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"}
        }
      }
    },
    "status": {
      "type": "object",
      "required": ["ready", "vision_provider", "degraded_reasons"],
      "properties": {
        "ready": {"type": "boolean"},
        "vision_provider": {"enum": ["openai", "demo", "none", "unknown"]},
        "degraded_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
